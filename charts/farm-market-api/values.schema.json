{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "image", "imagePullSecrets", "containerName", "ports", "terminationGracePeriodSeconds", "env", "resources", "startupProbe", "readinessProbe", "livenessProbe", "service", "ingress"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "pattern": "^[^ @]+$"},
        "tag": {"type": "string", "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127}$", "not": {"enum": ["latest", "dev", "stg", "prod"]}},
        "pullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}
    },
    "containerName": {"type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "ports": {
      "type": "array", "minItems": 1,
      "contains": {"required": ["name"], "properties": {"name": {"const": "http"}, "protocol": {"const": "TCP"}}},
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "containerPort", "protocol"],
        "properties": {
          "name": {"type": "string", "maxLength": 15, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "allOf": [{"pattern": "[a-z]"}]},
          "containerPort": {"$ref": "#/definitions/port"},
          "protocol": {"enum": ["TCP", "UDP", "SCTP"]}
        }
      }
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 31},
    "env": {
      "type": "array",
      "allOf": [
        {"contains": {"required": ["name"], "properties": {"name": {"const": "SPRING_PROFILES_ACTIVE"}}}},
        {"contains": {"required": ["name"], "properties": {"name": {"const": "SERVER_PORT"}, "value": {"pattern": "^[1-9][0-9]{0,4}$"}}}}
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$",
            "not": {"enum": ["SPRING_DATASOURCE_PASSWORD", "JWT_SECRET", "REDIS_PASSWORD"]}
          },
          "value": {"type": "string"}
        },
        "allOf": [
          {"if": {"properties": {"name": {"const": "SPRING_PROFILES_ACTIVE"}}}, "then": {"properties": {"value": {"enum": ["dev", "prod"]}}}},
          {"if": {"properties": {"name": {"const": "SERVER_PORT"}}}, "then": {"properties": {"value": {"pattern": "^[1-9][0-9]{0,4}$"}}}}
        ]
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"requests": {"$ref": "#/definitions/resourceList"}, "limits": {"$ref": "#/definitions/resourceList"}}
    },
    "startupProbe": {"$ref": "#/definitions/tcpProbe"},
    "readinessProbe": {"$ref": "#/definitions/tcpProbe"},
    "livenessProbe": {"$ref": "#/definitions/tcpProbe"},
    "service": {
      "type": "object", "additionalProperties": false, "required": ["port"],
      "properties": {"port": {"$ref": "#/definitions/port"}}
    },
    "ingress": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "className", "host", "paths", "tls"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "host": {"type": "string"},
        "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
        "tls": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["secretName", "hosts"], "properties": {"secretName": {"type": "string", "minLength": 1}, "hosts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}
        }
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {"className": {"minLength": 1}}}
    }
  },
  "allOf": [{"if": {"properties": {"env": {"contains": {"required": ["name", "value"], "properties": {"name": {"const": "SPRING_PROFILES_ACTIVE"}, "value": {"const": "prod"}}}}}}, "then": {"properties": {"terminationGracePeriodSeconds": {"minimum": 61}}}}],
  "definitions": {
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "resourceList": {"type": "object", "additionalProperties": false, "properties": {"cpu": {"type": "string", "minLength": 1}, "memory": {"type": "string", "minLength": 1}}},
    "tcpProbe": {
      "type": "object", "additionalProperties": false, "required": ["tcpSocket"],
      "properties": {
        "tcpSocket": {"type": "object", "additionalProperties": false, "required": ["port"], "properties": {"port": {"const": "http"}}},
        "periodSeconds": {"type": "integer", "minimum": 1},
        "timeoutSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1},
        "initialDelaySeconds": {"type": "integer", "minimum": 0}
      }
    }
  }
}
