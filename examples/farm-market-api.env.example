# Copy to a private *.env file and fill all values before creating the Secret.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Base64-encoded random key, at least 32 bytes before encoding.
JWT_SECRET=
REDIS_HOST=
REDIS_PASSWORD=
# Spring property farm-market.image.base-url; prod must use an external image server.
FARMMARKET_IMAGE_BASEURL=
